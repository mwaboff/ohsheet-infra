#!/usr/bin/env bash
set -euo pipefail

STAGING=/srv/ohsheet/infra-staging
LIVE=/srv/ohsheet

# 1. Scripts first: they restart nothing, and step 2 needs the current backup.sh
install -m 0755 "$STAGING/scripts/backup.sh"       /usr/local/bin/ohsheet-backup.sh
install -m 0755 "$STAGING/scripts/disk-check.sh"   /usr/local/bin/ohsheet-disk-check.sh
install -d /usr/local/lib/ohsheet
install -m 0644 "$STAGING/scripts/lib/emit-event.sh" /usr/local/lib/ohsheet/emit-event.sh

# 2. Fresh backup before anything below can restart postgres (image bump,
# compose change, docker daemon restart). Captured in a variable so that a
# compose error aborts the deploy (set -e) instead of silently skipping the
# backup; a failed backup aborts it too. No compose.yaml yet = first deploy on
# a freshly bootstrapped host: nothing is running, nothing to back up.
pg_running=""
if [ -f "$LIVE/compose.yaml" ]; then
    pg_running=$(docker compose -f "$LIVE/compose.yaml" ps postgres --status running --quiet)
fi
if [ -n "$pg_running" ]; then
    /usr/local/bin/ohsheet-backup.sh
fi

# 3. Config files into live locations
install -m 0644 "$STAGING/compose.yaml"            "$LIVE/compose.yaml"
install -m 0644 "$STAGING/caddy/Caddyfile"         "$LIVE/caddy/Caddyfile"

# 4. systemd units
install -m 0644 "$STAGING"/systemd/*.service "$STAGING"/systemd/*.timer /etc/systemd/system/
systemctl daemon-reload
systemctl enable --now pg-backup.timer disk-check.timer \
                       logrotate-ohsheet.timer docker-prune.timer

# 5. logrotate, unattended-upgrades policy, docker daemon config
install -m 0644 "$STAGING/logrotate/ohsheet" /etc/logrotate.d/ohsheet
install -m 0644 "$STAGING/apt/52ohsheet-unattended-upgrades" \
    /etc/apt/apt.conf.d/52ohsheet-unattended-upgrades

# Only restart docker if daemon.json actually changed
if ! cmp -s "$STAGING/docker/daemon.json" /etc/docker/daemon.json 2>/dev/null; then
    install -m 0644 "$STAGING/docker/daemon.json" /etc/docker/daemon.json
    systemctl restart docker
fi

# 6. Live Caddy reload if compose is up (zero-downtime config apply)
if docker compose -f "$LIVE/compose.yaml" ps dawn --quiet 2>/dev/null | grep -q .; then
    docker compose -f "$LIVE/compose.yaml" exec -T dawn \
        caddy reload --config /etc/caddy/Caddyfile || true
fi

# 7. Pull postgres explicitly so a failed pull fails the deploy instead of
# being swallowed below (the running container is untouched if this fails).
# --policy missing: only fetch when compose.yaml names an image we don't have,
# so routine deploys never swap postgres onto a silently rebuilt tag.
docker compose -f "$LIVE/compose.yaml" pull --quiet --policy missing postgres

# 8. Apply compose changes without touching image tags
# --no-build: never build locally; images are pushed by core/dawn release workflows.
# Pull failures are tolerated (images may not exist yet on first infra deploy).
docker compose -f "$LIVE/compose.yaml" up -d --no-build 2>&1 || {
    echo "NOTE: docker compose up failed (images may not exist yet). Continuing."
}

# 9. Update apply-infra itself LAST so an error above doesn't leave us with a broken script
if [ -f "$STAGING/apply-infra" ] && ! cmp -s "$STAGING/apply-infra" /usr/local/sbin/apply-infra; then
    install -m 0755 "$STAGING/apply-infra" /usr/local/sbin/apply-infra
fi
